# Copy this file to .env (next to docker-compose.yml) and fill it in.
# Keep .env private: it holds your Asana personal access token.

# Asana → profile photo → Settings → Apps → Developer apps → create a personal access token.
ASANA_TOKEN=

# How often the NAS checks Asana for changes made there, in seconds (minimum 15).
ASANA_POLL_SECONDS=60
